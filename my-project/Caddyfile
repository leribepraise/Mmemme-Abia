{
    admin off
    persist_config off
    auto_https off
}

:{$PORT:8080} {
    encode zstd gzip
    request_body {
        max_size 6MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }

    handle /health/frontend/ {
        respond "ok" 200
    }

    @appUpdates path /sw.js /manifest.webmanifest /blog-shell.html /blog-shell-loader.js
    header @appUpdates Cache-Control "no-cache"

    # /admin belongs to the React staff dashboard. Django admin stays on the backend domain.
    @backend path /api /api/* /static /static/* /media /media/* /health/* /blog /blog/* /blog-media/* /sitemap.xml
    handle @backend {
        reverse_proxy {$BACKEND_UPSTREAM} {
            # Railway terminates public HTTPS; never trust a client-supplied value.
            header_up X-Forwarded-Proto https
            header_up Host {host}
        }
    }

    handle {
        root * /app/dist
        route {
            @versioned path /assets/* /optimized/*
            header @versioned Cache-Control "public, max-age=31536000, immutable"
            @images {
                path *.png *.jpg *.jpeg *.webp *.svg *.avif *.woff2
                not path /assets/* /optimized/*
            }
            header @images Cache-Control "public, max-age=86400"
            try_files {path} /index.html
            @index path /index.html
            header @index Cache-Control "no-cache"
            file_server
        }
    }
}
