# REFERENCE TEMPLATE ONLY: paste variables into Railway backend and worker services.
# Railway resolves ${{service.VARIABLE}}; a local .env file cannot resolve them.
# Service names below are case-sensitive: frontend, backend, Postgres, Redis, uploads.
# Replace secrets privately in Railway. Do not commit a populated copy.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-new-random-secret-at-least-50-characters
ALLOWED_HOSTS=${{frontend.RAILWAY_PUBLIC_DOMAIN}}
FRONTEND_URL=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
CORS_ALLOWED_ORIGINS=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_SSLMODE=require
REDIS_URL=${{Redis.REDIS_URL}}
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-private-resend-sending-key
DEFAULT_FROM_EMAIL="Mmemme Abia <noreply@notifications.mmemme.com.ng>"
MEDIA_STORAGE=s3
S3_BUCKET_NAME=${{uploads.BUCKET}}
S3_ACCESS_KEY_ID=${{uploads.ACCESS_KEY_ID}}
S3_SECRET_ACCESS_KEY=${{uploads.SECRET_ACCESS_KEY}}
S3_ENDPOINT_URL=${{uploads.ENDPOINT}}
S3_REGION=${{uploads.REGION}}
S3_ADDRESSING_STYLE=virtual
PAYSTACK_SECRET_KEY=replace-with-paystack-test-secret
PLATFORM_COMMISSION_BPS=0
PAYOUT_HOLD_DAYS=7
PAYSTACK_TRANSFERS_ENABLED=false
TRUST_PROXY_SSL_HEADER=true
# Add ONLY on backend:
# PORT=8000
# WEB_CONCURRENCY=2
# Add ONLY on frontend (no backend secrets):
# PORT=8080
# BACKEND_UPSTREAM=${{backend.RAILWAY_PRIVATE_DOMAIN}}:8000
