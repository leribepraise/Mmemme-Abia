SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# PostgreSQL, Redis and SMTP are mandatory when using production settings.
DATABASE_URL=postgresql://mmemme:replace-me@db:5432/mmemme
DB_SSLMODE=require
REDIS_URL=redis://redis:6379/0
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
PAYSTACK_SECRET_KEY=
PLATFORM_COMMISSION_BPS=0
EVENT_COMMISSION_BPS=500
PAYSTACK_TRANSFERS_ENABLED=false
# Proposed default; confirm settlement timing in provider contracts before launch.
PAYOUT_HOLD_DAYS=7
TRUST_PROXY_SSL_HEADER=False

# Optional browser push. Use the same generated pair on backend and worker only.
# See docs/PUSH_AND_APP_INSTALL.md. Keep private keys out of Git and the frontend.
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
